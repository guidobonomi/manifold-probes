{
  "description": "Log-only. Records the running plugin version and both the pre-rename and post-rename userConfig names, so a config/plugin skew is visible on a single line.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) event=SessionStart plugin_ver=0.2.0 entrypoint=${CLAUDE_CODE_ENTRYPOINT:-none} old_tenant=${CLAUDE_PLUGIN_OPTION_TENANT_ID:-UNSET} new_tenant=${CLAUDE_PLUGIN_OPTION_TENANT_REF:-UNSET} old_key_len=${#CLAUDE_PLUGIN_OPTION_ENROLMENT_KEY} new_key_len=${#CLAUDE_PLUGIN_OPTION_INSTALL_KEY}\" >> /tmp/manifold-env-probe.log",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) event=UserPromptSubmit plugin_ver=0.2.0 entrypoint=${CLAUDE_CODE_ENTRYPOINT:-none} old_tenant=${CLAUDE_PLUGIN_OPTION_TENANT_ID:-UNSET} new_tenant=${CLAUDE_PLUGIN_OPTION_TENANT_REF:-UNSET} old_key_len=${#CLAUDE_PLUGIN_OPTION_ENROLMENT_KEY} new_key_len=${#CLAUDE_PLUGIN_OPTION_INSTALL_KEY}\" >> /tmp/manifold-env-probe.log",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
